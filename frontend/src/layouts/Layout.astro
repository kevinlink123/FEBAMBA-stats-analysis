---
import '../styles/global.css'

interface Categoria {
    nombre: string;
    slug: string;
}

const categorias: Categoria[] = [
    { nombre: "Pre Mini", slug: "premini" },
    { nombre: "Mini", slug: "mini" },
    { nombre: "U13", slug: "u13" },
    { nombre: "U15", slug: "u15" },
    { nombre: "U17", slug: "u17" },
    { nombre: "U21", slug: "u21" },
    { nombre: "Primera Flex", slug: "flex" },
    { nombre: "Primera Superior", slug: "primera" },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>EFF</title>
		<script>
        document.addEventListener("DOMContentLoaded", () => {
            const dropdownBtn = document.getElementById("dropdownBtn");
            const dropdownMenu = document.getElementById("dropdownMenu");

            if (dropdownBtn && dropdownMenu) {
                // Toggle al hacer click
                dropdownBtn.addEventListener("click", (e) => {
                    e.stopPropagation();
                    dropdownMenu.classList.toggle("hidden");
                });

                // Cerrar al hacer click fuera
                document.addEventListener("click", (e) => {
                    if (!e.target) return;
                    //@ts-ignore
                    if (
                        //@ts-ignore
                        !dropdownBtn.contains(e.target) && !dropdownMenu.contains(e.target)
                    ) {
                        dropdownMenu.classList.add("hidden");
                    }
                });

                // Cerrar al hacer click en un enlace del dropdown
                dropdownMenu.querySelectorAll("a").forEach((link) => {
                    link.addEventListener("click", () => {
                        dropdownMenu.classList.add("hidden");
                    });
                });
            }
        });
    </script>
	</head>
	<header
        class="bg-white/90 backdrop-blur-sm border-b border-[#e8e8e8] sticky top-0 z-50"
    >
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <!-- Logo -->
                <a
                    href="/"
                    class="text-xl font-medium tracking-tight text-[#1e1e1e] hover:text-[#333] transition-colors"
                >
                    EFF <span class="font-light text-[#888]">· FEBAMBA</span>
                </a>

                <!-- Navegación -->
                <nav class="flex items-center gap-6">
                    <!-- Enlace Inicio -->
                    <a
                        href="/"
                        class="text-[#444] hover:text-[#1e1e1e] text-sm font-medium transition-colors border-b-2 border-transparent hover:border-[#1e1e1e] pb-0.5"
                    >
                        Inicio
                    </a>

                    <!-- Dropdown Categorías -->
                    <div class="relative">
                        <button
                            id="dropdownBtn"
                            class="flex items-center gap-1.5 text-[#444] hover:text-[#1e1e1e] text-sm font-medium transition-colors border-b-2 border-transparent hover:border-[#1e1e1e] pb-0.5 cursor-pointer"
                        >
                            Categorías
                            <svg
                                class="w-4 h-4 transition-transform duration-200"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </button>

                        <!-- Menú desplegable -->
                        <div
                            id="dropdownMenu"
                            class="hidden absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-[#e8e8e8] py-1.5 z-50 transition-all duration-200 origin-top-right"
                        >
                            {
                                categorias.map((categoria) => (
                                    <a
                                        href={`/categoria/${categoria.slug}`}
                                        class="block px-4 py-2 text-sm text-[#444] hover:bg-[#f5f5f5] hover:text-[#1e1e1e] transition-colors"
                                    >
                                        {categoria.nombre}
                                    </a>
                                ))
                            }
                        </div>
                    </div>
                </nav>
            </div>
        </div>
    </header>
	<body class="bg-[#f5f5f5] font-['Segoe_UI',Roboto,system-ui,sans-serif] min-h-screen flex flex-col">
		<slot></slot>
        <script src="../scripts/auth.js"></script>
	</body>
	<footer class="bg-white border-t border-[#e8e8e8] mt-auto">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-5">
            <div
                class="flex flex-col sm:flex-row justify-between items-center gap-3 text-xs sm:text-sm text-[#999]"
            >
                <span
                    >&copy; 2026 Mi Aplicación. Todos los derechos
                    reservados.</span
                >
                <div class="flex gap-4">
                    <a
                        href="#privacidad"
                        class="text-[#666] hover:text-[#1e1e1e] transition-colors"
                        >Privacidad</a
                    >
                    <a
                        href="#terminos"
                        class="text-[#666] hover:text-[#1e1e1e] transition-colors"
                        >Términos</a
                    >
                    <a
                        href="#contacto"
                        class="text-[#666] hover:text-[#1e1e1e] transition-colors"
                        >Contacto</a
                    >
                </div>
            </div>
        </div>
    </footer>
</html>
